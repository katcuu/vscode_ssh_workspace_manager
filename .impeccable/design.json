      "html": "<section class=\"ds-clone-result ds-clone-success\" role=\"status\" aria-live=\"polite\"><div class=\"ds-clone-content\"><div class=\"ds-clone-heading\"><strong>✓ 本机克隆完成</strong><button class=\"ds-clone-dismiss\" aria-label=\"关闭克隆结果\">×</button></div><p class=\"ds-clone-message\">仓库已克隆，可以打开项目。</p><code class=\"ds-clone-path\">/home/dev/projects/demo-project</code></div><div class=\"ds-clone-actions\"><button class=\"ds-clone-current\">当前窗口打开</button><button class=\"ds-clone-new\">新窗口打开</button></div></section>",
      "css": ".ds-clone-result{font:13px/1.45 var(--vscode-font-family, sans-serif);color:var(--vscode-foreground);display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin:0 0 12px;padding:10px 12px;border:1px solid var(--vscode-focusBorder);border-radius:5px;background:var(--vscode-textBlockQuote-background);}.ds-clone-success{border-color:var(--vscode-testing-iconPassed,var(--vscode-focusBorder));}.ds-clone-success .ds-clone-heading strong{color:var(--vscode-testing-iconPassed,var(--vscode-foreground));}.ds-clone-cancelled{border-color:var(--vscode-descriptionForeground);}.ds-clone-failed{border-color:var(--vscode-inputValidation-errorBorder);background:var(--vscode-inputValidation-errorBackground);}.ds-clone-failed .ds-clone-heading strong{color:var(--vscode-errorForeground);}.ds-clone-content{flex:1;min-width:0;}.ds-clone-heading{display:flex;justify-content:space-between;align-items:center;gap:10px;}.ds-clone-heading strong{font-size:13px;}.ds-clone-message{margin:4px 0;overflow-wrap:anywhere;}.ds-clone-path{display:block;margin-top:5px;font-size:12px;overflow-wrap:anywhere;word-break:break-word;}.ds-clone-result progress{display:block;width:100%;height:5px;margin-top:6px;accent-color:var(--vscode-progressBar-background);}.ds-clone-actions{display:flex;flex-wrap:wrap;gap:4px;flex:0 0 auto;align-items:flex-start;}.ds-clone-current{cursor:pointer;padding:4px 9px;border-radius:4px;border:1px solid var(--vscode-button-border, var(--vscode-panel-border));font:13px/1.45 var(--vscode-font-family, sans-serif);background:var(--vscode-button-secondaryBackground);color:var(--vscode-button-secondaryForeground);}.ds-clone-current:hover{background:var(--vscode-button-secondaryHoverBackground);}.ds-clone-current:focus-visible{outline:1px solid var(--vscode-focusBorder);outline-offset:2px;}.ds-clone-current:disabled{cursor:default;opacity:.45;}.ds-clone-new{cursor:pointer;padding:4px 9px;border-radius:4px;border:1px solid var(--vscode-button-border, var(--vscode-panel-border));font:13px/1.45 var(--vscode-font-family, sans-serif);background:var(--vscode-button-background);color:var(--vscode-button-foreground);}.ds-clone-new:hover{background:var(--vscode-button-hoverBackground);}.ds-clone-new:focus-visible{outline:1px solid var(--vscode-focusBorder);outline-offset:2px;}.ds-clone-new:disabled{cursor:default;opacity:.45;}.ds-clone-dismiss{cursor:pointer;padding:4px 9px;border-radius:4px;border:1px solid var(--vscode-button-border, var(--vscode-panel-border));font:13px/1.45 var(--vscode-font-family, sans-serif);background:var(--vscode-button-secondaryBackground);color:var(--vscode-button-secondaryForeground);flex:0 0 auto;min-width:30px;padding:3px 7px;font-size:16px;}.ds-clone-dismiss:hover{background:var(--vscode-button-secondaryHoverBackground);}.ds-clone-dismiss:focus-visible{outline:1px solid var(--vscode-focusBorder);outline-offset:2px;}.ds-clone-dismiss:disabled{cursor:default;opacity:.45;}@media(max-width:720px){.ds-clone-result{flex-direction:column;}.ds-clone-actions{flex-wrap:wrap;}}@media(max-width:430px){.ds-clone-actions button{padding:6px 8px;}}"

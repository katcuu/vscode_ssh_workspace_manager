  "narrative": {
    "northStar": "开发者的项目索引",
    "overview": "界面围绕查找、辨认和打开项目组织信息。原生左侧栏承载来源导航，右侧 Webview 提供项目名称、来源与完整路径的阅读空间。主要视觉线索是文字层级、细边框、操作强调色和可辨认的状态。\n\n组件的描述为“克制、直接、状态明确”。工作区沿用 VS Code 的字体和主题语义，固定的品牌颜色保留在图标资源中。按钮、路径和提示优先呈现其用途；当前管理页没有自定义阴影、装饰性渐变或自定义过渡动画。\n\n本文依据 [管理页样式](media/dashboard.css)、[结构](media/dashboard.html)、[交互](media/dashboard.js)、[原生侧栏](src/serverTree.ts)与现有图标记录，采用 [DESIGN.md 格式](https://raw.githubusercontent.com/google-labs-code/design.md/main/docs/spec.md)。本次观察了已安装扩展的桌面深色界面；断点、其他主题和任务状态的规格来自源码扫描，不代表它们都经过本轮实机验收。前置产品约束见 [PRODUCT.md](PRODUCT.md)。",
    "keyCharacteristics": [
      "宿主主题决定工作区颜色，原生侧栏负责来源导航。",
      "名称、来源与完整路径形成可扫描的项目行。",
      "紧凑操作与可换行内容共存，长列表有自己的滚动区域。",
      "连接与克隆使用文字、状态标识和进度共同反馈。"
    ],
    "rules": [
      {
        "name": "The Host Theme Rule.",
        "body": "工作区保留宿主语义映射，不把某次截图的颜色固定到其他主题。",
        "section": "colors"
      },
      {
        "name": "The Readable Path Rule.",
        "body": "通过收缩、换行和局部滚动保留完整路径与操作入口，不把窄侧栏中的截断问题带回管理页。",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule.",
        "body": "延续边框与底色分层的现有语法；记录或复用组件时不顺便添加悬浮卡片和阴影层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 使用宿主主题变量及其现有回退链，保留配对的背景色与文字色。",
      "**Do** 通过名称、辅助信息和等宽完整路径形成稳定的信息层级。",
      "**Do** 复用现有圆角、细边框、键盘焦点轮廓和按钮禁用状态。",
      "**Do** 在受限列表内保留滚动，并在窄视口中让文字与操作自然换行。",
      "**Do** 让连接、克隆和目录选择同时有文字或标识反馈。"
    ],
    "donts": [
      "**Don't** 把当前深色截图、图标色或预览色带当作所有主题的工作区配色。",
      "**Don't** 把所有内容塞回原生窄侧栏，或用路径截断替代现有的完整路径换行。",
      "**Don't** 在记录现有系统时新增阴影、装饰渐变、字体或组件动效。",
      "**Don't** 隐去焦点轮廓，或只用颜色表达克隆结果与选中状态。",
      "**Don't** 把全局克隆反馈误写成悬浮固定栏，或把目录和项目行改成整行点击即打开。"
    ]
  }
}
